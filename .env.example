# Copier ce fichier en .env et renseigner les valeurs. Ne jamais versionner .env.

# --- Site (aussi à déclarer dans les variables d'environnement Cloudflare Pages) ---
# Token GitHub en lecture seule, limité aux dépôts publics (PRD F2.6)
GITHUB_TOKEN=

# --- Atelier vidéo : services locaux ---
COMFYUI_URL=http://127.0.0.1:8000
LMSTUDIO_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODELE=qwen/qwen3.5-9b   # sinon, le premier modèle téléchargé
# LMSTUDIO_CONTEXTE=16384
VOICESTUDIO_URL=http://127.0.0.1:3900
# VOICESTUDIO_CLE=                  # seulement si l'API VoiceStudio exige une clé

# --- Atelier vidéo : API payantes (confirmation avant chaque dépense, PRD ST3) ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
RUNWAY_API_KEY=
HIGGSFIELD_API_KEY=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# --- Publication YouTube (API YouTube Data v3, OAuth) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
